# Copy to .env and fill in. .env is gitignored and never leaves the server.
ANTHROPIC_API_KEY=
# SMTP for digests/alerts (Gmail app password recommended). Leave blank to
# write digests to reports/ instead of emailing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
DIGEST_TO=you@example.com
# Optional aggregator keys
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GITHUB_TOKEN=
# Safety: bot fills forms + screenshots but does NOT submit while true
DRY_RUN=true
